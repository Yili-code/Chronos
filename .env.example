# Telegram: fill these four values to enable webhook messages.
CHRONOS_TELEGRAM_BOT_TOKEN=
CHRONOS_TELEGRAM_WEBHOOK_SECRET=
CHRONOS_TELEGRAM_CHAT_ID=
CHRONOS_PUBLIC_BASE_URL=
CHRONOS_SCHEDULER_SECRET=
CHRONOS_ENABLE_INTERNAL_SCHEDULER=true
CHRONOS_DATABASE_PATH=chronos.db
# Cloud Run uses Firestore. Local development defaults to SQLite.
CHRONOS_DATABASE_BACKEND=sqlite
CHRONOS_FIRESTORE_PROJECT_ID=
CHRONOS_FIRESTORE_DATABASE=(default)
CHRONOS_FIRESTORE_COLLECTION_PREFIX=chronos
CHRONOS_WEB_USERNAME=chronos
# Set a password before exposing the Web interface publicly.
CHRONOS_WEB_PASSWORD=
CHRONOS_TIMEZONE=Asia/Taipei
# Gemini API.
CHRONOS_GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
CHRONOS_GEMINI_API_KEY=
CHRONOS_GEMINI_MODEL=gemini-3.8-flash
CHRONOS_AI_TIMEOUT=30
