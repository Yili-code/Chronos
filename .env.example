# Telegram: fill these four values to enable webhook messages.
CHRONOS_TELEGRAM_BOT_TOKEN=
CHRONOS_TELEGRAM_WEBHOOK_SECRET=
CHRONOS_TELEGRAM_CHAT_ID=
CHRONOS_PUBLIC_BASE_URL=
CHRONOS_SCHEDULER_SECRET=
CHRONOS_ASSIGNMENT_SCAN_JOB=
CHRONOS_ASSIGNMENT_SCAN_PROJECT=
CHRONOS_ASSIGNMENT_SCAN_REGION=asia-east1
CHRONOS_ENABLE_INTERNAL_SCHEDULER=true
CHRONOS_ENABLE_STUDY_TRACKING=false
# Gmail uses its own OAuth grant, separate from ChatGPT/Codex connectors.
# Run: python -m chronos.gmail_authorize --client-secret .gmail/client.json --account you@gmail.com
CHRONOS_ENABLE_GMAIL=false
CHRONOS_GMAIL_ACCOUNT=
CHRONOS_GMAIL_CLIENT_ID=
CHRONOS_GMAIL_CLIENT_SECRET=
CHRONOS_GMAIL_REFRESH_TOKEN=
# Exact addresses or @domains that must never be auto-trashed, comma-separated.
CHRONOS_GMAIL_KEEP_SENDERS=
CHRONOS_GMAIL_MAX_MESSAGES=100
CHRONOS_DATABASE_PATH=chronos.db
# Cloud Run uses Firestore. Local development defaults to SQLite.
CHRONOS_DATABASE_BACKEND=sqlite
CHRONOS_FIRESTORE_PROJECT_ID=
CHRONOS_FIRESTORE_DATABASE=(default)
CHRONOS_FIRESTORE_COLLECTION_PREFIX=chronos
CHRONOS_TIMEZONE=Asia/Taipei
# Set automatically by the deployment script; do not edit for local development.
CHRONOS_RELEASE_SHA=
# Cloud assignment scanner. These are provisioned as Secret Manager values in production.
CHRONOS_TRONCLASS_USERNAME=
CHRONOS_TRONCLASS_PASSWORD=
# Optional comma-separated numeric course IDs to exclude from the configured course roster.
CHRONOS_TRONCLASS_EXCLUDED_COURSE_IDS=
# Gemini API.
CHRONOS_GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
CHRONOS_GEMINI_API_KEY=
# Optional secondary key from a separately provisioned project. Leave blank to disable.
CHRONOS_GEMINI_API_KEY_SECONDARY=
# Cooldown after failure; provider Retry-After / RetryInfo can extend this.
CHRONOS_GEMINI_KEY_COOLDOWN_SECONDS=60
CHRONOS_GEMINI_MODEL=gemini-3.5-flash-lite
CHRONOS_AI_TIMEOUT=30
# Learning Calendar requires a separate Google grant and cloud activation.
CHRONOS_ENABLE_LEARNING_CALENDAR=false
CHRONOS_CALENDAR_CLIENT_ID=
CHRONOS_CALENDAR_CLIENT_SECRET=
CHRONOS_CALENDAR_REFRESH_TOKEN=
CHRONOS_CALENDAR_ACCOUNT=
CHRONOS_CALENDAR_ID=primary
CHRONOS_CALENDAR_BUSY_IDS=primary
CHRONOS_LEARNING_ENABLED_SINCE=
CHRONOS_LEARNING_START_HOUR=9
CHRONOS_LEARNING_END_HOUR=21
CHRONOS_LEARNING_MINUTES=90
CHRONOS_LEARNING_DAILY_MINUTES=540
CHRONOS_LEARNING_CLASS_PREPARATION_MINUTES=30
# Backward Planning (/backward) shares these hours, daily cap and Calendar grant.
# Date-only deadlines plan work by the previous day; see docs/backward-planning.md.
