# Telegram: fill these four values to enable webhook messages.
CHRONOS_TELEGRAM_BOT_TOKEN=
CHRONOS_TELEGRAM_WEBHOOK_SECRET=
CHRONOS_TELEGRAM_CHAT_ID=
CHRONOS_PUBLIC_BASE_URL=
# Windows paths: use forward slashes.
CHRONOS_PROJECTS_ROOT=C:/Users/User/Documents/Developing
CHRONOS_DATABASE_PATH=chronos.db
# Optional: GitHub metadata access.
CHRONOS_GITHUB_TOKEN=
CHRONOS_WEB_USERNAME=chronos
# Set a password before exposing the Web interface publicly.
CHRONOS_WEB_PASSWORD=
CHRONOS_TIMEZONE=Asia/Taipei
# External AI: OpenAI-compatible Chat Completions API base URL (including /v1 if required).
CHRONOS_AI_BASE_URL=
CHRONOS_AI_API_KEY=
CHRONOS_AI_MODEL=
CHRONOS_AI_TIMEOUT=30
